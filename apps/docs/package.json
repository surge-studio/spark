{
  "name": "@spark/docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @spark/registry check && pnpm --filter @spark/registry sync && next build --webpack",
    "dev": "pnpm --filter @spark/registry build && pnpm --filter @spark/registry check && pnpm --filter @spark/registry sync && next dev",
    "start": "next start",
    "typecheck": "node scripts/clean-generated-types.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@spark/content": "workspace:*",
    "@spark/registry": "workspace:*",
    "@spark/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
